<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Upstream runtime and generated sources do not use nullable annotations. -->
        <Nullable>disable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <None Update="Bytes/*.bytes" TargetPath="Config/Bytes/%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="Luban/LICENSE" TargetPath="Licenses/Luban/LICENSE"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
