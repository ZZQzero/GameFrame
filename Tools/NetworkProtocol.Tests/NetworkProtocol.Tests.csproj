<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../DotNet/Game.Protocol/Game.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Unity/Assets/Scripts/Runtime/Network/NetworkOptions.cs" Link="Contracts/NetworkOptions.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Runtime/Network/NetworkConnectOptions.cs" Link="Contracts/NetworkConnectOptions.cs" />
    <ProjectReference Include="../../DotNet/NetworkProtocol/NetworkProtocol.csproj" />
    <Compile Include="../../Unity/Assets/Scripts/Tests/EditMode/Network/NetworkProtocolTests.cs" Link="NetworkProtocolTests.cs" />
    <Compile Include="../../Unity/Assets/Scripts/Tests/EditMode/Network/NetworkMemoryPackTests.cs" Link="NetworkMemoryPackTests.cs" />
  </ItemGroup>
</Project>
