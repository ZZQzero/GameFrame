set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES GFNET_LLVM_MINGW)
if(NOT GFNET_LLVM_MINGW)
  message(FATAL_ERROR "Pass the LLVM-MinGW toolchain root as GFNET_LLVM_MINGW")
endif()
if(CMAKE_HOST_WIN32)
  set(GFNET_COMPILER_SUFFIX .exe)
endif()
set(CMAKE_C_COMPILER "${GFNET_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang${GFNET_COMPILER_SUFFIX}")
set(CMAKE_CXX_COMPILER "${GFNET_LLVM_MINGW}/bin/x86_64-w64-mingw32-clang++${GFNET_COMPILER_SUFFIX}")
set(CMAKE_RC_COMPILER "${GFNET_LLVM_MINGW}/bin/x86_64-w64-mingw32-windres${GFNET_COMPILER_SUFFIX}")
set(CMAKE_FIND_ROOT_PATH "${GFNET_LLVM_MINGW}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
